<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Lets "Call back" place the call straight away instead of opening the dialer -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Finds the phone number of a WhatsApp contact so you can call back on your SIM -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Calendar tab: shows the events of the Google Calendar synced to this phone (read only). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <!-- Sends your scheduled text messages from your own SIM -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Only used when "Stop when the person replies Done" is on: checks incoming texts for "Done" -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets reminders ring at the exact minute. Android 12 needs the first one, 13 and later the second
         (granted automatically to reminder apps). Without either, alarms fall back to "within a few minutes". -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Call recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Only needed to play a ringtone you picked from your own music/files -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- WhatsApp buttons: see which WhatsApp apps are installed (Settings › WhatsApp). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".CallbackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Callback">

        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- configChanges: split screen, pop-up view and rotation resize the screen instead of
             restarting it, so an open popup keeps everything typed in it. -->

        <!-- The small popup that appears right after a call ends -->
        <activity
            android:name=".PostCallActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Callback.Popup"
            android:windowSoftInputMode="adjustResize" />

        <!-- The full-screen ringing reminder: stays until you Call back, Snooze or mark Done -->
        <activity
            android:name=".ReminderAlertActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@style/Theme.Callback.Alert" />

        <!-- The twice-a-day review reminder popup: Review now, Snooze or Later -->
        <activity
            android:name=".ReviewAlertActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@style/Theme.Callback.Alert" />

        <!-- Plays the ringtone while a reminder is ringing -->
        <service
            android:name=".ReminderRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Call recording. Switching this Accessibility service on is what lets Android keep the
             microphone working during a call. It does not read the screen. -->
        <service
            android:name=".RecorderAccessibilityService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="@string/rec_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_recorder" />
        </service>

        <!-- Fallback: keeps the app running while a call is recorded -->
        <service
            android:name=".CallRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Detects when a call ends -->
        <receiver
            android:name=".CallEndReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Detects when a WhatsApp call ends (needs Notification access) -->
        <service
            android:name=".WhatsAppCallListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fires when a reminder is due -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Fires at the review times (and when a review reminder is snoozed) -->
        <receiver
            android:name=".ReviewReceiver"
            android:exported="false" />

        <!-- Snooze / Done buttons on the reminder notification -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <!-- Sends a scheduled text message when it is due -->
        <receiver
            android:name=".SmsAlarmReceiver"
            android:exported="false" />

        <!-- Hears whether a text went out and was delivered -->
        <receiver
            android:name=".SmsResultReceiver"
            android:exported="false" />

        <!-- Stops a person's reminders when they text back exactly "Done" (only if switched on) -->
        <receiver
            android:name=".SmsReplyReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Try again / Mark done / Not done on the text-message notifications -->
        <receiver
            android:name=".SmsActionReceiver"
            android:exported="false" />

        <!-- Reminds you to switch call recording back on after "Switch off for banking" -->
        <receiver
            android:name=".BankingReminderReceiver"
            android:exported="false" />

        <!-- My tasks and Dossier: due times, "remind me before", Done buttons, the dossier reminder -->
        <receiver
            android:name=".TaskReceiver"
            android:exported="false" />

        <!-- ✓ Received on a team "Done, check it" notification -->
        <receiver
            android:name=".TeamActionReceiver"
            android:exported="false" />

        <!-- The review session's resume reminder and End on its paused notification -->
        <receiver
            android:name=".ReviewSessionReceiver"
            android:exported="false" />

        <!-- Re-arms reminders after a phone restart or app update -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ShutdownReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
            </intent-filter>
        </receiver>

        <!-- Home screen widgets (drawn with Glance). Added from the home screen: long-press › Widgets. -->
        <receiver
            android:name=".FollowUpsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_follow_ups_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_follow_ups" />
        </receiver>
        <receiver
            android:name=".MyTasksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_my_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_my_tasks" />
        </receiver>
        <receiver
            android:name=".ReviewWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_review_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_review" />
        </receiver>
        <receiver
            android:name=".DailyTicksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_daily_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily" />
        </receiver>
        <receiver
            android:name=".QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add" />
        </receiver>
        <receiver
            android:name=".TasksCalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_cal_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cal_tasks" />
        </receiver>
        <receiver
            android:name=".FollowUpsCalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_cal_follow_ups_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cal_follow_ups" />
        </receiver>

        <!-- What widget buttons open: a call or text straight away, or a small popup over the home screen -->
        <activity
            android:name=".WidgetActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Callback.Popup" />

        <!-- "Which number has WhatsApp?": a small sheet over whatever is open, for people with two or more numbers -->
        <activity
            android:name=".WaNumberActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Callback.Popup" />

        <!-- A widget's setup page: when it is dropped on the home screen, and on long-press -->
        <activity
            android:name=".WidgetSetupActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Callback">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/team_files" />
        </provider>
    </application>
</manifest>
