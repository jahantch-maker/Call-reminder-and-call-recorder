<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Callback" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF5F6FA</item>
    </style>

    <style name="Theme.Callback.Popup" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Theme.Callback.Alert" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B0E17</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
