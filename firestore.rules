rules_version = '2';

// Callback Reminder · Team edition + Rafiq Builders portal (Firebase project rafiq-builders).
// Paste this into Firebase console › Firestore Database › Rules › Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function member(t) { return get(/databases/$(database)/documents/teams/$(t)/members/$(me())).data; }
    function isMember(t) { return exists(/databases/$(database)/documents/teams/$(t)/members/$(me())); }
    function isActive(t) { return isMember(t) && member(t).status == 'active'; }
    function isAdmin(t) { return isActive(t) && member(t).role in ['owner', 'admin']; }
    function isOwner(t) { return get(/databases/$(database)/documents/teams/$(t)).data.ownerUid == me(); }
    // v0.49 portal access: 'none' | 'view' | 'edit' for one portal section, from the member's resolved permissions.
    function lvl(t, sec) { return member(t).get('perms', {}).get('portal', {}).get(sec, 'none'); }
    function portalEdit(t, sec) { return isActive(t) && (isOwner(t) || lvl(t, sec) == 'edit'); }
    function portalSee(t, sec) { return isActive(t) && (isOwner(t) || lvl(t, sec) in ['view', 'edit']); }
    function appSw(t, k) { return member(t).get('perms', {}).get('app', {}).get(k, false) == true; }
    // v0.59.1 Team Performance with "how far" = everyone (an auditor, a GM outside the chart): reads everyone's phone data, view only.
    function seesAll(t) { return isActive(t) && lvl(t, 'app') != 'none' && member(t).get('perms', {}).get('portal', {}).get('appScope', 'own') == 'all'; }
    function otherMember(t, u) { return get(/databases/$(database)/documents/teams/$(t)/members/$(u)).data; }

    // Join codes: anyone signed in can look one up; made once with the team.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && isOwner(request.resource.data.teamId);
    }

    // Which team a person is in (to find it again on a new phone). Only your own.
    match /users/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    match /teams/{t} {
      allow read: if signedIn() && isMember(t);
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update: if signedIn() && isOwner(t) && request.resource.data.ownerUid == resource.data.ownerUid;

      match /members/{uid} {
        allow read: if signedIn() && (uid == me() || isActive(t));
        // Asking to join: yourself, as a pending member. The owner's own row when the team is made.
        // v0.49 A Gmail the owner already added as a seat joins that seat at once (no permissions of its own: the portal fills them).
        allow create: if signedIn() && uid == me() && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'member') ||
          (isOwner(t) && request.resource.data.role == 'owner' && request.resource.data.status == 'active') ||
          (request.resource.data.status == 'active' && request.resource.data.role == 'member'
            // v0.50 The join may carry the seat's own permissions (the portal keeps them on the seat), never anything else.
            && (!('perms' in request.resource.data) || request.resource.data.perms == get(/databases/$(database)/documents/teams/$(t)/seats/$(request.auth.token.email.lower())).data.get('perms', null))
            && request.auth.token.email_verified == true
            && request.resource.data.seatId == request.auth.token.email.lower()
            && exists(/databases/$(database)/documents/teams/$(t)/seats/$(request.auth.token.email.lower()))));
        // Owner/Admin: approve, chart, role, remove. v0.49 a person with Team Edit access does the same for non-owners.
        // Yourself: only harmless fields.
        allow update: if signedIn() && (
          (isAdmin(t) && resource.data.role != 'owner' && request.resource.data.role != 'owner') ||
          (isAdmin(t) && uid == me()) ||
          (isOwner(t)) ||
          (portalEdit(t, 'team') && resource.data.role != 'owner' && request.resource.data.role != 'owner') ||
          (appSw(t, 'approveJoins') && resource.data.status == 'pending' && request.resource.data.role == 'member') ||
          // v0.49.1 Someone who left, was removed or is still waiting asks again (an RB seat holder rejoins his seat at once).
          (uid == me() && resource.data.status in ['pending', 'removed'] && request.resource.data.role == 'member' && !('perms' in request.resource.data) && (
            request.resource.data.status == 'pending' ||
            (request.resource.data.status == 'active' && request.auth.token.email_verified == true
              && request.resource.data.seatId == request.auth.token.email.lower()
              && exists(/databases/$(database)/documents/teams/$(t)/seats/$(request.auth.token.email.lower()))))) ||
          (uid == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'name', 'phone', 'backupAt', 'email', 'signedOut', 'photo'])) ||
          // v0.50 A seat holder who signed in on the phone first copies the permissions of his own seat (nothing else, nothing different).
          (uid == me() && resource.data.status == 'active' && resource.data.role == 'member' && resource.data.get('seatId', '') == request.auth.token.email.lower()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perms'])
            && request.resource.data.perms == get(/databases/$(database)/documents/teams/$(t)/seats/$(request.auth.token.email.lower())).data.get('perms', null)));
        // Leaving (yourself) or declining a request (Owner/Admin). v0.49 members cannot leave an RB seat: only owners remove.
        allow delete: if signedIn() && ((uid == me() && !('seatId' in resource.data)) || (isAdmin(t) && resource.data.role != 'owner') || isOwner(t) || ((portalEdit(t, 'team') || appSw(t, 'approveJoins')) && resource.data.status == 'pending'));
      }

      // v0.49 Seats: one per official Gmail (the document id is the lowercase Gmail). Anyone signed in may look up the seat of
      // their own Gmail (to join); members read them all; the owner or a Team editor writes them.
      match /seats/{gmail} {
        allow read: if signedIn() && (isActive(t) || (request.auth.token.email.lower() == gmail));
        allow write: if signedIn() && portalEdit(t, 'team');
      }

      // v0.49 Change log: owners read it; every access, chart, seat and offboard change adds a line; nobody edits or deletes one.
      match /changelog/{c} {
        allow read: if signedIn() && isActive(t) && isOwner(t);
        allow create: if signedIn() && isActive(t) && request.resource.data.by == me()
          && (isOwner(t) || lvl(t, 'team') == 'edit' || lvl(t, 'docs') == 'edit' || lvl(t, 'settings') == 'edit' || lvl(t, 'plot') == 'edit');
        allow update, delete: if false;
      }

      // v0.49 Documents (Google Drive links): job descriptions, SOPs and work documents. Every member reads them (the portal shows
      // each person only his designation's); the owner or a Documents editor writes them. The Drive files carry their own sharing.
      match /docs/{d} {
        allow read: if signedIn() && isActive(t);
        allow write: if signedIn() && portalEdit(t, 'docs');
      }

      // v0.49 Policies: owners only, plus the designations an owner shared each one with. Only owners write them.
      // Staff find theirs through config/policyIndex (designation → policy ids) and read each one by id.
      match /policies/{d} {
        allow get: if signedIn() && isActive(t) && (isOwner(t) || lvl(t, 'docs') == 'edit'
          || member(t).get('designation', '') in resource.data.get('shareWith', []));
        allow list: if signedIn() && isActive(t) && (isOwner(t) || lvl(t, 'docs') == 'edit');
        allow write: if signedIn() && isActive(t) && isOwner(t);
      }

      // Plot files (Plot files project): the file of each plot (steps, items, notes) is read by everyone with Plot files access
      // and written by Plot files editors. Cheques and amounts sit in a separate record that only the owner and people the owner
      // ticked "See money details" for can read or write, so hiding money is real, not just on screen.
      match /plotfiles/{p} {
        allow read: if signedIn() && portalSee(t, 'plot');
        allow write: if signedIn() && portalEdit(t, 'plot');
      }
      // Plot files SOP versions pulled from the master Google Sheet (draft, settings with the sheet link, v1, v2...): owner only.
      // The published SOP itself is config/plotsop (read by every member, written by the owner, see config above).
      match /plotsopv/{p} {
        allow read, write: if signedIn() && isActive(t) && isOwner(t);
      }
      match /plotmoney/{p} {
        allow read, write: if signedIn() && isActive(t) && (isOwner(t) || (lvl(t, 'plot') in ['view', 'edit'] && appSw(t, 'seeMoney')));
      }

      // v0.49 Reading progress: he marks his own; the owner, Documents editors and his heads read it.
      match /reading/{u} {
        allow read: if signedIn() && isActive(t) && (u == me() || isOwner(t) || lvl(t, 'docs') == 'edit' || me() in otherMember(t, u).get('managers', []));
        allow write: if signedIn() && isActive(t) && u == me();
      }

      // v0.49 Emergency cloud backup (nightly, last 7 nights): readable and writable only by that person, never by the owner.
      match /backups/{u}/nights/{n} {
        allow read, write: if signedIn() && isActive(t) && u == me();
      }

      // Team tasks: seen by the giver, the person it is for, and everyone above either of them.
      match /tasks/{task} {
        // v0.48 the owner also reads every task, for the team meeting web app.
        allow read: if signedIn() && isActive(t) && (me() in resource.data.viewers || isOwner(t) || seesAll(t));
        allow create: if signedIn() && isActive(t) && request.resource.data.fromUid == me() && me() in request.resource.data.viewers;
        allow update: if signedIn() && isActive(t) && (me() in resource.data.viewers || isOwner(t))
          && request.resource.data.fromUid == resource.data.fromUid
          // Only the giver (or, when someone is offboarded, an owner) may give it to someone else (Edit › person).
          && (request.resource.data.toUid == resource.data.toUid || resource.data.fromUid == me() || isOwner(t));
        // Plot files: a plot step task (plot: true) is read by everyone with Plot files access; a note from the web
        // only touches its "last message" counters.
        allow read: if signedIn() && resource.data.get('plot', false) == true && portalSee(t, 'plot');
        allow update: if signedIn() && resource.data.get('plot', false) == true && portalEdit(t, 'plot')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsgAt', 'lastMsgBy', 'lastMsgText', 'nBy', 'nPhoto']);

        // Plot files: only the owner may delete, and only a step task of a test file (the web "Delete test file" button).
        allow delete: if signedIn() && isActive(t) && isOwner(t) && resource.data.get('plot', false) == true && resource.data.get('test', false) == true;

        // Timeline talk: text, voice notes and photos, seen by the same people as the task.
        // Only the sender writes a message; anyone who sees it may clear old media (after 90 days).
        match /msgs/{m} {
          allow read: if signedIn() && isActive(t) && (me() in resource.data.viewers || isOwner(t) || seesAll(t));
          allow create: if signedIn() && isActive(t) && request.resource.data.fromUid == me() && me() in request.resource.data.viewers;
          allow update: if signedIn() && isActive(t) && me() in resource.data.viewers
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'text'])
              // ✓✓ Ticks: each person marks only their own seen / played time.
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'playedBy'])
              // The giver hands the Timeline on with the task.
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
                && get(/databases/$(database)/documents/teams/$(t)/tasks/$(task)).data.fromUid == me()));
          // Plot files: the step Timeline is read on the web, and notes (text or photo) are written there as the writer himself.
          allow read: if signedIn() && portalSee(t, 'plot') && get(/databases/$(database)/documents/teams/$(t)/tasks/$(task)).data.get('plot', false) == true;
          allow create: if signedIn() && portalEdit(t, 'plot') && request.resource.data.fromUid == me()
            && get(/databases/$(database)/documents/teams/$(t)/tasks/$(task)).data.get('plot', false) == true;
        }
      }

      // v0.53 Help threads (@mentions on a Timeline): the person who asked and the people he asked, nobody else.
      // The owner (who asked) writes the whole document; a helper may only change the helpers list (Solved) and the
      // "last message" fields. The talk (msgs) is written by whoever is in the thread, as himself.
      match /helps/{h} {
        allow read: if signedIn() && isActive(t) && me() in resource.data.viewers;
        allow create: if signedIn() && isActive(t) && request.resource.data.ownerUid == me() && me() in request.resource.data.viewers;
        allow update: if signedIn() && isActive(t) && me() in resource.data.viewers
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (resource.data.ownerUid == me()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpers', 'lastMsgAt', 'lastMsgBy', 'lastMsgText', 'updatedAt']));
        allow delete: if signedIn() && isActive(t) && resource.data.ownerUid == me();

        match /msgs/{m} {
          allow read: if signedIn() && isActive(t) && me() in get(/databases/$(database)/documents/teams/$(t)/helps/$(h)).data.viewers;
          // getAfter: the first message is written in the same batch that creates or updates the thread.
          allow create: if signedIn() && isActive(t) && request.resource.data.fromUid == me()
            && me() in getAfter(/databases/$(database)/documents/teams/$(t)/helps/$(h)).data.viewers;
        }
      }

      // Each member's Dossier: he and the people above him read it. The Owner sets it; so do a senior with
      // "Sets Dossier of people under him" and the member himself with "Adds his own Dossier", but they can only
      // add blocks (never remove one): only the Owner deletes.
      match /dossier/{uid} {
        allow read: if signedIn() && isActive(t) && (uid == me() || isOwner(t) || seesAll(t) || me() in resource.data.viewers);
        allow write: if signedIn() && isActive(t) && (isOwner(t) || (
          ((uid == me() && member(t).get('ownDossier', false) == true) ||
           (member(t).get('setDossier', false) == true &&
            me() in get(/databases/$(database)/documents/teams/$(t)/members/$(uid)).data.get('managers', []))) &&
          request.resource != null &&
          (resource == null || request.resource.data.blocks.size() >= resource.data.blocks.size())));
      }

      // 📷 Dossier photo proofs and "why not done" voice notes: written by him, read by the people above him.
      match /proofs/{p} {
        allow read: if signedIn() && isActive(t) && me() in resource.data.viewers;
        allow create, update: if signedIn() && isActive(t) && request.resource.data.uid == me() && me() in request.resource.data.viewers;
      }

      // v0.48 Own My tasks (never 🔒 Private) shared for the team meeting: written by him, read by him and the owner.
      match /own/{uid}/tasks/{task} {
        allow write: if signedIn() && uid == me() && isActive(t);
        // v0.49 and the people above him, when they have App view access in the portal.
        allow read: if signedIn() && isActive(t) && (uid == me() || isOwner(t) || seesAll(t) || (lvl(t, 'app') != 'none' && me() in otherMember(t, uid).get('managers', [])));
      }

      // v0.48 Late reasons, red lines and meeting steps: the owner sets them in the web app; every member reads them.
      // v0.49 designations: Team editors; reasons: Settings editors or a person with "Edit late-reason list"; the rest: Settings editors.
      match /config/{doc} {
        allow read: if signedIn() && isActive(t);
        allow write: if signedIn() && isActive(t) && (isOwner(t)
          || (doc == 'designations' && lvl(t, 'team') == 'edit')
          || (doc == 'reasons' && (lvl(t, 'settings') == 'edit' || appSw(t, 'editReasons')))
          || (doc == 'meeting' && lvl(t, 'settings') == 'edit'));
        // config/plotsteps (Plot files rules and timing) is written by the owner only (isOwner above).
      }

      // v0.48 Team meetings (attendance, decisions, notes, actions). v0.49 Meetings "Edit" runs them, "View" reads the minutes.
      match /meetings/{m} {
        allow read: if signedIn() && portalSee(t, 'meetings');
        allow write: if signedIn() && portalEdit(t, 'meetings');
      }

      // Each person's day (tasks, follow-ups, dossier ticks; 🔒 private ones only counted), for the people above.
      match /days/{uid} {
        allow write: if signedIn() && uid == me() && isActive(t);
        allow read: if signedIn() && isActive(t) && (uid == me() || me() in resource.data.managers || isOwner(t) || seesAll(t));
      }
    }
  }
}
