rules_version = '2';

// Callback Reminder · Team edition (Firebase project rafiq-builders).
// Paste this into Firebase console › Firestore Database › Rules › Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function member(t) { return get(/databases/$(database)/documents/teams/$(t)/members/$(me())).data; }
    function isMember(t) { return exists(/databases/$(database)/documents/teams/$(t)/members/$(me())); }
    function isActive(t) { return isMember(t) && member(t).status == 'active'; }
    function isAdmin(t) { return isActive(t) && member(t).role in ['owner', 'admin']; }
    function isOwner(t) { return get(/databases/$(database)/documents/teams/$(t)).data.ownerUid == me(); }

    // Join codes: anyone signed in can look one up; made once with the team.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && isOwner(request.resource.data.teamId);
    }

    // Which team a person is in (to find it again on a new phone). Only your own.
    match /users/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    match /teams/{t} {
      allow read: if signedIn() && isMember(t);
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update: if signedIn() && isOwner(t) && request.resource.data.ownerUid == resource.data.ownerUid;

      match /members/{uid} {
        allow read: if signedIn() && (uid == me() || isActive(t));
        // Asking to join: yourself, as a pending member. The owner's own row when the team is made.
        allow create: if signedIn() && uid == me() && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'member') ||
          (isOwner(t) && request.resource.data.role == 'owner' && request.resource.data.status == 'active'));
        // Owner/Admin: approve, chart, role, remove. Yourself: only harmless fields.
        allow update: if signedIn() && (
          (isAdmin(t) && resource.data.role != 'owner' && request.resource.data.role != 'owner') ||
          (isAdmin(t) && uid == me()) ||
          (uid == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'name', 'phone'])));
        // Leaving (yourself) or declining a request (Owner/Admin).
        allow delete: if signedIn() && (uid == me() || (isAdmin(t) && resource.data.role != 'owner'));
      }

      // Team tasks: seen by the giver, the person it is for, and everyone above either of them.
      match /tasks/{task} {
        // v0.48 the owner also reads every task, for the team meeting web app.
        allow read: if signedIn() && isActive(t) && (me() in resource.data.viewers || isOwner(t));
        allow create: if signedIn() && isActive(t) && request.resource.data.fromUid == me() && me() in request.resource.data.viewers;
        allow update: if signedIn() && isActive(t) && me() in resource.data.viewers
          && request.resource.data.fromUid == resource.data.fromUid
          // Only the giver may give it to someone else (Edit › person).
          && (request.resource.data.toUid == resource.data.toUid || resource.data.fromUid == me());

        // Timeline talk: text, voice notes and photos, seen by the same people as the task.
        // Only the sender writes a message; anyone who sees it may clear old media (after 90 days).
        match /msgs/{m} {
          allow read: if signedIn() && isActive(t) && (me() in resource.data.viewers || isOwner(t));
          allow create: if signedIn() && isActive(t) && request.resource.data.fromUid == me() && me() in request.resource.data.viewers;
          allow update: if signedIn() && isActive(t) && me() in resource.data.viewers
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'text'])
              // ✓✓ Ticks: each person marks only their own seen / played time.
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'playedBy'])
              // The giver hands the Timeline on with the task.
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
                && get(/databases/$(database)/documents/teams/$(t)/tasks/$(task)).data.fromUid == me()));
        }
      }

      // Each member's Dossier: he and the people above him read it. The Owner sets it; so do a senior with
      // "Sets Dossier of people under him" and the member himself with "Adds his own Dossier", but they can only
      // add blocks (never remove one): only the Owner deletes.
      match /dossier/{uid} {
        allow read: if signedIn() && isActive(t) && (uid == me() || isOwner(t) || me() in resource.data.viewers);
        allow write: if signedIn() && isActive(t) && (isOwner(t) || (
          ((uid == me() && member(t).get('ownDossier', false) == true) ||
           (member(t).get('setDossier', false) == true &&
            me() in get(/databases/$(database)/documents/teams/$(t)/members/$(uid)).data.get('managers', []))) &&
          request.resource != null &&
          (resource == null || request.resource.data.blocks.size() >= resource.data.blocks.size())));
      }

      // 📷 Dossier photo proofs and "why not done" voice notes: written by him, read by the people above him.
      match /proofs/{p} {
        allow read: if signedIn() && isActive(t) && me() in resource.data.viewers;
        allow create, update: if signedIn() && isActive(t) && request.resource.data.uid == me() && me() in request.resource.data.viewers;
      }

      // v0.48 Own My tasks (never 🔒 Private) shared for the team meeting: written by him, read by him and the owner.
      match /own/{uid}/tasks/{task} {
        allow write: if signedIn() && uid == me() && isActive(t);
        allow read: if signedIn() && isActive(t) && (uid == me() || isOwner(t));
      }

      // v0.48 Late reasons, red lines and meeting steps: the owner sets them in the web app; every member reads them.
      match /config/{doc} {
        allow read: if signedIn() && isActive(t);
        allow write: if signedIn() && isOwner(t);
      }

      // v0.48 Team meetings (attendance, decisions, notes, actions): the owner only.
      match /meetings/{m} {
        allow read, write: if signedIn() && isOwner(t);
      }

      // Each person's day (tasks, follow-ups, dossier ticks; 🔒 private ones only counted), for the people above.
      match /days/{uid} {
        allow write: if signedIn() && uid == me() && isActive(t);
        allow read: if signedIn() && isActive(t) && (uid == me() || me() in resource.data.managers);
      }
    }
  }
}
